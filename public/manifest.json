{
  "manifest_version": 3,
  "name": "Clipboard+",
  "description": "A private, searchable clipboard history for text, links, code, and reusable snippets.",
  "version": "1.7.0",
  "permissions": ["storage", "activeTab", "clipboardWrite", "scripting", "contextMenus", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Clipboard+",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html"
}
